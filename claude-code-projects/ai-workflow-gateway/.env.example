# Copy to runtime/.env and fill in real values.
# runtime/ is gitignored — the populated file must never be committed.
# chmod 600 runtime/.env after creating it.

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional — leave blank (along with telegram_chat_id in config.yaml) to disable
# Telegram entirely. Email notifications work fine without it.
TELEGRAM_BOT_TOKEN=
